
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Simulado — Direito Disciplinar PMPR</title>
<style>
  :root{
    --azul:#1a3a5c; --azul2:#2e5f8a; --dourado:#c9a227;
    --verde:#1e7a3c; --vermelho:#b3261e; --cinza:#f4f6f9;
  }
  *{box-sizing:border-box}
  body{
    font-family:'Segoe UI',Roboto,Arial,sans-serif;
    margin:0; background:linear-gradient(160deg,#e9eef5,#f7f9fc);
    color:#1c2733; line-height:1.55;
  }
  header{
    background:linear-gradient(135deg,var(--azul),var(--azul2));
    color:#fff; padding:32px 20px; text-align:center;
    border-bottom:5px solid var(--dourado);
  }
  header h1{margin:0 0 6px; font-size:1.7rem; letter-spacing:.5px}
  header p{margin:0; opacity:.85; font-size:.95rem}
  .container{max-width:900px; margin:0 auto; padding:24px 16px 80px}

  .progress-wrap{
    position:sticky; top:0; z-index:50;
    background:#fff; border-radius:12px; padding:14px 18px;
    box-shadow:0 4px 14px rgba(0,0,0,.08);
    margin-bottom:22px;
    display:flex; align-items:center; gap:14px; flex-wrap:wrap;
  }
  .bar{flex:1; min-width:140px; height:12px; background:#e3e8ef; border-radius:10px; overflow:hidden}
  .bar span{display:block; height:100%; width:0; background:linear-gradient(90deg,var(--dourado),#e8c96a); transition:width .35s}
  .progress-wrap b{color:var(--azul)}
  .score{font-weight:700; color:var(--azul); white-space:nowrap}

  .q-card{
    background:#fff; border-radius:14px; padding:22px 22px 18px;
    margin-bottom:20px; box-shadow:0 3px 12px rgba(0,0,0,.06);
    border-left:5px solid var(--azul2);
    animation:fade .4s ease;
  }
  @keyframes fade{from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:none}}
  .q-head{display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:10px}
  .q-num{
    background:var(--azul); color:#fff; font-size:.78rem; font-weight:700;
    padding:4px 10px; border-radius:20px; white-space:nowrap;
  }
  .tag{
    font-size:.72rem; background:#eef3f9; color:var(--azul2);
    padding:3px 9px; border-radius:20px; border:1px solid #d7e2ee;
  }
  .q-text{font-size:1.02rem; margin:8px 0 16px; font-weight:600}
  .q-text small{display:block; font-weight:400; color:#5a6b7d; margin-top:4px}

  .alt{
    display:flex; gap:12px; align-items:flex-start;
    border:2px solid #e3e8ef; border-radius:10px;
    padding:12px 14px; margin-bottom:10px; cursor:pointer;
    transition:.18s; background:#fff;
  }
  .alt:hover{border-color:var(--azul2); background:#f7fafd}
  .alt .letter{
    width:28px; height:28px; flex:0 0 28px; border-radius:50%;
    background:#eef3f9; color:var(--azul); font-weight:700;
    display:flex; align-items:center; justify-content:center; font-size:.85rem;
  }
  .alt.sel{border-color:var(--azul); background:#eaf2fb}
  .alt.sel .letter{background:var(--azul); color:#fff}
  .alt.correct{border-color:var(--verde); background:#e8f6ec}
  .alt.correct .letter{background:var(--verde); color:#fff}
  .alt.wrong{border-color:var(--vermelho); background:#fdecea}
  .alt.wrong .letter{background:var(--vermelho); color:#fff}
  .alt.locked{cursor:default}
  .alt.locked:hover{background:inherit}

  /* V/F */
  .vf-row{display:flex; gap:12px; margin-bottom:12px; align-items:stretch}
  .vf-btn{
    flex:1; padding:14px; border:2px solid #e3e8ef; border-radius:10px;
    background:#fff; cursor:pointer; font-weight:700; font-size:1.05rem;
    transition:.18s; color:var(--azul);
  }
  .vf-btn:hover{border-color:var(--azul2); background:#f7fafd}
  .vf-btn.sel{background:var(--azul); color:#fff; border-color:var(--azul)}
  .vf-btn.correct{background:var(--verde); color:#fff; border-color:var(--verde)}
  .vf-btn.wrong{background:var(--vermelho); color:#fff; border-color:var(--vermelho)}
  .vf-btn.locked{cursor:default}
  .vf-text{flex:3; padding:6px 0; font-size:.97rem}

  .feedback{
    margin-top:14px; padding:14px 16px; border-radius:10px;
    font-size:.93rem; display:none;
  }
  .feedback.show{display:block; animation:fade .3s}
  .feedback.ok{background:#e8f6ec; border-left:4px solid var(--verde)}
  .feedback.no{background:#fdecea; border-left:4px solid var(--vermelho)}
  .feedback strong{display:block; margin-bottom:4px}

  .btn{
    background:var(--azul); color:#fff; border:none; border-radius:10px;
    padding:14px 26px; font-size:1rem; font-weight:700; cursor:pointer;
    transition:.2s; box-shadow:0 4px 12px rgba(26,58,92,.25);
  }
  .btn:hover{background:var(--azul2); transform:translateY(-1px)}
  .btn:disabled{opacity:.5; cursor:not-allowed; transform:none}
  .btn-outline{background:#fff; color:var(--azul); border:2px solid var(--azul); box-shadow:none}
  .btn-outline:hover{background:#eef3f9}

  .actions{display:flex; gap:12px; flex-wrap:wrap; margin:10px 0 30px}

  .result{
    background:linear-gradient(135deg,#fff,#f0f5fa);
    border:2px solid var(--dourado); border-radius:16px;
    padding:30px 24px; text-align:center; display:none;
    box-shadow:0 8px 26px rgba(0,0,0,.1);
  }
  .result.show{display:block; animation:fade .5s}
  .result h2{color:var(--azul); margin:0 0 10px}
  .big{font-size:3rem; font-weight:800; color:var(--dourado); line-height:1}
  .result p{margin:10px 0; color:#3c4c5d}
  .stats{display:flex; justify-content:center; gap:24px; flex-wrap:wrap; margin:18px 0}
  .stat{background:#fff; border-radius:12px; padding:14px 22px; box-shadow:0 2px 8px rgba(0,0,0,.06); min-width:110px}
  .stat b{display:block; font-size:1.5rem; color:var(--azul)}
  .stat span{font-size:.8rem; color:#5a6b7d}
  .mention{font-size:1.15rem; font-weight:700; color:var(--verde); margin-top:8px}
  .mention.low{color:var(--vermelho)}
  .mention.mid{color:#c9a227}
  footer{text-align:center; padding:20px; color:#7b8a9a; font-size:.82rem}
  .hidden{display:none !important}
</style>
</head>
<body>
<header>
  <h1>🎯 Simulado — Direito Disciplinar PMPR</h1>
  <p>Lei 1.943/54 · Decreto 5.075/98 · RDE 4.346/02 · Lei 16.544/10 · Portarias CG</p>
</header>

<div class="container">
  <div class="progress-wrap">
    <div class="bar"><span id="barFill"></span></div>
    <b id="progressTxt">0 / 0 respondidas</b>
    <div class="score" id="scoreTxt">Acertos: 0</div>
  </div>

  <div id="quiz"></div>

  <div class="actions">
    <button class="btn" id="btnCorrigir" disabled>✅ Corrigir Simulado</button>
    <button class="btn btn-outline" id="btnReiniciar">🔄 Reiniciar</button>
  </div>

  <div class="result" id="resultado">
    <h2>Resultado Final</h2>
    <div class="big" id="pct">0%</div>
    <p id="resumo"></p>
    <div class="stats">
      <div class="stat"><b id="stAcertos">0</b><span>Acertos</span></div>
      <div class="stat"><b id="stErros">0</b><span>Erros</span></div>
      <div class="stat"><b id="stTotal">0</b><span>Total</span></div>
    </div>
    <div class="mention" id="mention"></div>
  </div>
</div>

<footer>Material de revisão — uso didático. Gabaritos conforme o arquivo original.</footer>

<script>
/* ============ BANCO DE QUESTÕES ============ */
const questoes = [
